{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.internal/workflow/event/v2",
  "title": "WorkflowEvent",
  "type": "object",
  "required": ["event_id", "event_type", "source", "timestamp", "version", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z_]+\\.[a-z_]+\\.[a-z_]+$"
    },
    "source": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "correlation_id": {
      "type": "string"
    },
    "causation_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "retry_count": { "type": "integer", "minimum": 0 },
        "origin_queue": { "type": "string" },
        "ttl_seconds": { "type": "integer", "minimum": 1 },
        "flags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
