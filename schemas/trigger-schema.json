{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.internal/workflow/trigger/v1",
  "title": "TriggerDefinition",
  "type": "object",
  "required": ["trigger_id", "trigger_type", "target_workflow", "enabled"],
  "properties": {
    "trigger_id": {
      "type": "string",
      "format": "uuid"
    },
    "trigger_type": {
      "type": "string",
      "enum": ["event", "schedule", "webhook", "manual", "dependency"]
    },
    "target_workflow": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "tenant_id": { "type": "string" },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "operator", "value"],
        "properties": {
          "field": { "type": "string" },
          "operator": { "type": "string", "enum": ["eq", "neq", "gt", "lt", "in", "not_in", "exists"] },
          "value": {}
        }
      }
    },
    "event_config": {
      "type": "object",
      "properties": {
        "event_types": { "type": "array", "items": { "type": "string" } },
        "source_filter": { "type": "string" }
      }
    },
    "schedule_config": {
      "type": "object",
      "properties": {
        "cron_expression": { "type": "string" },
        "timezone": { "type": "string" },
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" }
      }
    },
    "webhook_config": {
      "type": "object",
      "properties": {
        "path_suffix": { "type": "string" },
        "auth_strategy": { "type": "string", "enum": ["hmac", "bearer", "api_key", "none"] },
        "idempotency_header": { "type": "string" }
      }
    },
    "payload_mapping": {
      "type": "object"
    },
    "throttle": {
      "type": "object",
      "properties": {
        "max_per_minute": { "type": "integer" },
        "burst_limit": { "type": "integer" }
      }
    }
  },
  "additionalProperties": false
}
